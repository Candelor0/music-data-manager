# 复制本文件为 .env，然后在等号后填值。
# .env 已在 .gitignore 中，不会被提交。
# ⚠️ 绝不把 .env 内容贴进对话、截图、日志或提交记录。

# ── AcoustID（声学指纹，免费）────────────────────────────
# 注册地址：https://acoustid.org/new-application
# 限速：约 3 请求/秒（已记入设计约束）
ACOUSTID_API_KEY=

# ── DeepSeek（云端匹配消歧，按量计费）──────────────────
# 注册地址：https://platform.deepseek.com
# 说明：开发期用于质量与成本验证；产品运行时由用户自己填，应用绝不内置
DEEPSEEK_API_KEY=

# ── MusicBrainz（元数据，免费）──────────────────────────
# 必须带规范 User-Agent：应用名/版本 ( 联系方式 )，否则可能被拒
# 限速：1 请求/秒
MUSICBRAINZ_USER_AGENT=MusicDataManager/0.1.0 ( contact: 请填一个邮箱 )
# ↑ 必须把「请填一个邮箱」换成你自己的邮箱，否则 MusicBrainz 会拒绝请求

# ── 音乐库（仅本机路径，不上传任何文件）────────────────
MUSIC_LIBRARY_PATH=

# ── 成本与批量上限 ─────────────────────────────────────
# 每 100 首云端调用成本上限（元）；超限即停止云端调用并转本地规则
CLOUD_BUDGET_PER_100_TRACKS=0.5
# 单批处理数量上限（首）
BATCH_SIZE_LIMIT=2000
